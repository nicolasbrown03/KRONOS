# Copia este archivo como .env y llena los valores
# NUNCA subas .env a GitHub

# Base de datos PostgreSQL (Render te da esta URL al crear la DB)
DATABASE_URL=postgresql://usuario:password@host:5432/kronos3

# JWT - Genera una clave segura con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_muy_larga_y_segura
JWT_EXPIRES_IN=8h

# Puerto del servidor (Render lo asigna automáticamente)
PORT=3000

# Entorno
NODE_ENV=development

# Zona horaria (Colombia)
TZ=America/Bogota

# Admin inicial (se crea solo al levantar el servidor por primera vez)
ADMIN_INITIAL_EMAIL=admin@somosinternet.co
ADMIN_INITIAL_PASSWORD=Kronos2026!

# IP de la API para detectar VPN (ipapi.co - gratis hasta 45k req/mes)
IPAPI_URL=https://ipapi.co
